{
  "name": "msfs-traffic-web-socket",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "protocol:generate": "bun scripts/generate-tower-protocol.ts",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "start": "bun .",
    "build": "bun build --compile --minify --sourcemap --bytecode --target=bun-windows-x64 --outfile out/fsd-bridge.exe --windows-icon=app.ico .",
    "build:lexe": "bun run build:bundle && lexe build -i=out/index.js -o=fsd-bridge -d=out -p=windows-x64",
    "build:standalone": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "lexe": "0.1.0-alpha.6",
    "oxlint": "^1.90.0",
    "protobufjs-cli": "2.7.1"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@rezi-ui/core": "^0.1.0-beta.2",
    "@rezi-ui/node": "^0.1.0-beta.2",
    "node-simconnect": "^4.2.1",
    "protobufjs": "8.8.1"
  }
}
